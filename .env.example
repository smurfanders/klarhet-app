# ── App ───────────────────────────────────────────────────────────────────────
# The public URL your app runs at (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-this-with-a-long-random-string-minimum-32-chars

# Used only once when creating your account via /setup — choose anything
SETUP_KEY=choose-any-secret-setup-key

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=5
